DATABASE_URL=postgres://nova:nova_dev_local@localhost:55432/nova_app
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h
PORT=3001
CORS_ORIGIN=http://localhost:5173

MINIO_ENDPOINT=http://localhost:59000
MINIO_ACCESS_KEY=nova_minio
MINIO_SECRET_KEY=nova_dev_local_minio
MINIO_BUCKET=hinode-imoveis
MINIO_PUBLIC_URL=http://localhost:59000/hinode-imoveis

CAPTACAO_SECRET=troque-este-segredo-antes-de-produzir

# Endpoint GET /api/integracoes/facebook/ativas (a automação n8n chama, não é JWT de usuário)
INTEGRACOES_SECRET=troque-este-segredo-antes-de-produzir
# Chave AES-256-GCM em base64 (32 bytes) para cifrar o token do Facebook em repouso:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRACOES_ENC_KEY=

# WhatsApp via WAHA (opcional — sem isso, o modo "número central" fica só visual).
# WAHA_URL: base da instância (ex: https://waha.inoovaweb.com.br)
# WAHA_API_KEY: X-Api-Key da instância
# PUBLIC_URL: URL pública DESTE backend, pro WAHA chamar o webhook de mensagens
# WAHA_WEBHOOK_SECRET: segredo do webhook (?secret=) — se vazio usa o CAPTACAO_SECRET
WAHA_URL=
WAHA_API_KEY=
PUBLIC_URL=
WAHA_WEBHOOK_SECRET=

# Painel Dono do SaaS (/plataforma) — cria o admin inicial no boot se a tabela estiver vazia.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Administrador
